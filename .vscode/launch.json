{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Crear historia Top-Down paso a paso (Gemini)",
            "type": "debugpy",
            "request": "launch",
            "module": "asg_top_down.cli",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}\\.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}\\packages\\core\\src;${workspaceFolder}\\packages\\evaluation\\src;${workspaceFolder}\\packages\\top_down\\src"
            },
            "console": "integratedTerminal",
            "stopOnEntry": true,
            "justMyCode": true,
            "subProcess": false
        }
    ]
}
