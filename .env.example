GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM_LIMIT=15
GEMINI_RPM_RESERVE=1
GEMINI_TPM_LIMIT=0
GEMINI_MAX_RETRIES=3
GEMINI_MAX_RETRY_DELAY=120
# Un 503 (o cualquier 5xx) es un modelo saturado: se espera GEMINI_OVERLOAD_WAIT segundos y se
# reintenta; al 503 numero GEMINI_OVERLOAD_ATTEMPTS la llamada pasa al siguiente modelo. Cada 503
# cuenta como peticion del cupo diario, asi que mas paciencia solo quema ese cupo.
GEMINI_OVERLOAD_ATTEMPTS=6
GEMINI_OVERLOAD_WAIT=10
GEMINI_REQUEST_TIMEOUT_MS=120000
# Modelo que prueban primero los actores de la funcion simulada; el director, la narracion y el
# resto siguen en GEMINI_MODEL. Gemini cuenta la cuota gratuita diaria por proyecto y por modelo:
# con otro modelo, los actores no gastan la del pipeline. Vacios heredan GEMINI_MODEL,
# GEMINI_API_KEY y GEMINI_RPM_LIMIT. La clave aparte es para un proyecto con su propia cuota
# (p. ej. de pago), no para multiplicar la gratuita.
GEMINI_STAGE_MODEL=gemini-3.1-flash-lite
GEMINI_STAGE_API_KEY=
GEMINI_STAGE_RPM_LIMIT=
# Modelo propio para la prosa que lee el lector (7.12): capitulos del borrador, reescrituras del
# Writer y narracion del simulado, nada mas. Vacio = GEMINI_MODEL. Flash da ~20 peticiones
# gratis al dia y ~5 por minuto (oct. 2026, comprobar en AI Studio); al agotarse, la prosa
# vuelve a GEMINI_MODEL sin perder el run. Solo sin ASG_LLM_CHAIN.
GEMINI_PROSE_MODEL=
GEMINI_PROSE_API_KEY=
GEMINI_PROSE_RPM_LIMIT=5
GEMINI_PROSE_DAILY_REQUESTS=20
# Cadena de proveedores (7.7): orden de uso cuando uno agota su cupo. Vacia, solo Gemini, como
# siempre. Un run que salta de proveedor guarda models_used en metadata.json y no se empareja
# con uno de un solo modelo. llm-budget muestra lo gastado. Los topes son los del nivel gratuito
# en octubre de 2026 y cambian sin aviso; 0 o vacio = sin tope (solo reacciona al 429).
ASG_LLM_CHAIN=
# Por modelo: con GEMINI_STAGE_MODEL el total de Gemini es el doble (1000).
GEMINI_DAILY_REQUESTS=500
# Groq: cada modelo de la lista es una ranura con su propio cupo (~1 historia por modelo y dia).
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_RPM_LIMIT=30
GROQ_DAILY_REQUESTS=1000
GROQ_DAILY_TOKENS=200000
# Mistral: 10 USD de credito al mes. En el nivel gratuito usa los prompts para entrenar.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_RPM_LIMIT=30
MISTRAL_MONTHLY_TOKENS=
TELEGRAM_BOT_TOKEN=
TTS_FALLBACK_VOICE=
ASG_PROJECT_ROOT=
ASG_NARRATIVE_GUIDANCE=true
ASG_PROMISE_LEDGER=true
ASG_STORY_FORMAT=narrative
ASG_SCRIPT_METHOD=native
ASG_NARRATIVE_VOICE=omniscient
ASG_ACTOR_MEMORY=own
ASG_SIMULATION_MODE=fixed
ASG_INVENTORY=false
ASG_STAGE_TURNS_PER_BEAT=8
RUN_GEMINI_LIVE=

# Estudio por pares (ruta relativa a la raiz). Vacio: Evaluations/estudio/study.sqlite3.
# El bot lo crea solo la primera vez, en fase de recogida.
ASG_EVALUATION_STUDY=
